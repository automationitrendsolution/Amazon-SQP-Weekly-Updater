# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Amazon SP-API (Login with Amazon app credentials) ----------------------------
# From Seller Central > Apps & Services > Develop Apps > your app > "View" LWA credentials.
SPAPI_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPAPI_LWA_CLIENT_SECRET=replace-me
# Refresh token from authorising the app for the selling account (self-authorisation).
# The app must have the "Brand Analytics" role and the account must be brand-registered.
SPAPI_LWA_REFRESH_TOKEN=Atzr|replace-me
# Amazon.com (US)
SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER
# Optional: overrides the regional endpoint derived from the marketplace.
# SPAPI_ENDPOINT=https://sellingpartnerapi-na.amazon.com

# AWS IAM keys / SigV4 signing are NOT needed: SP-API has accepted LWA-only
# requests since October 2023.

# --- MySQL ---------------------------------------------------------------------------
# The table the SQP weeks are written to; `run.py --inspect` reads it only.
# POWERBI_DB_HOST/_PORT/_USER/_PASSWORD/_NAME/_TABLE (the amazon_daily_data names) work too.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_NAME=powerbidb
DB_TABLE=2024BrandAnalytics

# --- Behaviour -----------------------------------------------------------------------
EXPECTED_ASIN_COUNT=60
# Timezone used to decide which SQP week is the latest completed one.
SQP_TIMEZONE=America/Los_Angeles
# Days after a week ends (Saturday) before it counts as available: 2 = from Monday (US Pacific).
SQP_AVAILABILITY_LAG_DAYS=2
# How often and how long one run waits for Amazon (the queue can take a day): 5 min, 22 h.
SQP_POLL_INTERVAL_SECONDS=300
SQP_POLL_TIMEOUT_SECONDS=79200
SQP_MAX_RETRIES=6
LOG_LEVEL=INFO
# Optional: move data/ (raw reports, state) or logs/ elsewhere.
# SQP_DATA_DIR=/data/cron/amazon-sqp-weekly-updater/data
# SQP_LOG_DIR=/data/cron/amazon-sqp-weekly-updater/logs

# --- Seller Central (run.py --sc-login / --sc-inspect) -------------------------------
# Sign-in for the Seller Central download. Seller Central always asks for 2-step verification:
# the first --sc-login waits for you to type the OTP and tick "Don't require OTP on this browser".
SELLERCENTRAL_EMAIL=replace-me   # AMAZON_EMAIL works too
SELLERCENTRAL_PASSWORD=replace-me   # AMAZON_PASSWORD works too
# Optional, only with your team lead's OK: the authenticator-app key, so codes are generated here.
# SELLERCENTRAL_TOTP_SECRET=

# --- Seller Central competitor scraping (run.py --sc-night) --------------------------
# First week (its Sunday) the nightly scraping covers.
SC_COMPETITORS_FROM=2026-10-11
# Browser: chrome (Google Chrome installed) or chromium (Playwright's build: `playwright install --with-deps chromium`).
SC_BROWSER_CHANNEL=chrome
# true = no window. On a Linux server prefer false under xvfb-run (a virtual screen), which looks like a normal browser.
SC_HEADLESS=false
